- var snsLinks = []
if theme.social.twitter
  - snsLinks.push({ href: `//twitter.com/${theme.social.twitter}`, label: 'Twitter' })
if theme.social.github
  - snsLinks.push({ href: `//github.com/${theme.social.github}`, label: 'GitHub' })
if theme.social.instagram
  - snsLinks.push({ href: `//www.instagram.com/${theme.social.instagram}`, label: 'Instagram' })
if config.feed && config.feed.enable
  - snsLinks.push({ href: url_for(config.feed.path), label: 'RSS' })
if theme.social.zhihu
  - snsLinks.push({ href: `//zhihu.com/${theme.social.zhihu}`, label: '知乎' })
if theme.social.linkedin
  - snsLinks.push({ href: `//www.linkedin.com/in/${theme.social.linkedin}`, label: 'LinkedIn' })
if theme.social.facebook
  - snsLinks.push({ href: `//www.facebook.com/${theme.social.facebook}`, label: 'Facebook' })
if snsLinks.length > 0
  section.sns-container
    each item, index in snsLinks
      if index > 0
        span.wm-sep= '|'
      a(title=item.label target="_blank" rel="noopener nofollow" href=item.href)= item.label
