extends widget/base

block append head
    link(rel='stylesheet' href= url_for('/style/about.css'))

block content
    main.about-page.content
        .container.is-max-widescreen.px-2
            if theme.about_pic
                figure.about-hero
                    img.js-img-fadeIn(src= url_for(theme.about_pic) alt= page.title || __('about'))
            article.about-content
                h2.about-title= __('about')
                != page.content
block append script
    script.
        $claudia.fadeInImage()
